{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "mkdir -p .hugo-bin && curl -sL https://github.com/gohugoio/hugo/releases/download/v0.167.0/hugo_extended_0.167.0_linux-amd64.tar.gz | tar xz -C .hugo-bin hugo",
  "buildCommand": "./.hugo-bin/hugo --gc --minify -b \"https://${VERCEL_PROJECT_PRODUCTION_URL:-$VERCEL_URL}/\"",
  "outputDirectory": "public"
}
